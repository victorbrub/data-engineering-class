        <!-- Notes -->
        <mxCell id="note1" value="&lt;b&gt;Normalized Structure:&lt;/b&gt;&lt;br&gt;• More tables, less redundancy&lt;br&gt;• More joins required (slower queries)&lt;br&gt;• Easier to maintain consistency&lt;br&gt;• Better for storage optimization" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;spacingLeft=5;fontSize=10;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="900" y="610" width="220" height="110" as="geometry" />
        </mxCell>
        
        <mxCell id="note2" value="&lt;b&gt;Example Hierarchies:&lt;/b&gt;&lt;br&gt;Customer → Location → Region&lt;br&gt;Product → Brand&lt;br&gt;Product → Category&lt;br&gt;Store → Region" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;spacingLeft=5;fontSize=10;fontColor=#333333;" vertex="1" parent="1">
